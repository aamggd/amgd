+package com.fush.erp.ui.export
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ReportTextLayoutTest {
+    private val unitMeasure: (String) -> Float = { it.codePointCount(0, it.length).toFloat() }
+
+    @Test
+    fun `oversized voucher token is hard wrapped within cell width`() {
+        val lines = ReportTextLayout.wrap(
+            text = "RV-20260815-033041-25566a",
+            maxWidth = 10f,
+            measure = unitMeasure
+        )
+
+        assertTrue(lines.size >= 3)
+        assertTrue(lines.all { unitMeasure(it) <= 10f })
+        assertEquals("RV-20260815-033041-25566a", lines.joinToString(""))
+    }
+
+    @Test
+    fun `arabic description and long reference never exceed width`() {
+        val lines = ReportTextLayout.wrap(
+            text = "تصحيح إنتاج الدفعة PROD-20260815-0002 بالقيد RV-20260815-033041-25566a",
+            maxWidth = 14f,
+            measure = unitMeasure
+        )
+
+        assertTrue(lines.size > 2)
+        assertTrue(lines.all { unitMeasure(it) <= 14f })
+    }
+
+    @Test
+    fun `explicit new lines remain separated`() {
+        val lines = ReportTextLayout.wrap(
+            text = "السطر الأول\nالسطر الثاني",
+            maxWidth = 50f,
+            measure = unitMeasure
+        )
+
+        assertEquals(listOf("السطر الأول", "السطر الثاني"), lines)
+    }
+}
