+    fun observeDistributorOrders(itemId: Long, provinceCode: String, planYear: Int, planMonth: Int): Flow<List<DistributorOrderView>> =
+        db.planningDao().observeDistributorOrders(itemId, provinceCode, planYear, planMonth)
+
+    suspend fun createDistributorOrder(
+        customerId: Long,
+        itemId: Long,
+        provinceCode: String,
+        planYear: Int,
+        planMonth: Int,
+        quantityBase: Double,
+        notes: String,
+        userId: Long
+    ): Long = db.withTransaction {
+        require(quantityBase.isFinite() && quantityBase > 0.0) { "كمية طلب الموزع يجب أن تكون أكبر من صفر." }
+        val customer = requireNotNull(db.customerDao().byId(customerId)) { "الموزع غير موجود." }
+        require(customer.isActive && customer.channel in setOf("DISTRIBUTOR_CASH", "DISTRIBUTOR_CREDIT")) { "اختر عميلاً معرفاً كموزع." }
+        val customerProvince = provinceCodeForPlanning(customer.province)
+        require(customerProvince == provinceCode) { "محافظة الموزع لا تطابق محافظة خطة الطلب المحددة." }
+        val item = requireNotNull(db.itemDao().byId(itemId)) { "المنتج غير موجود." }
+        require(item.isActive && item.category == "FINISHED_GOOD") { "طلبات الموزعين متاحة للمنتجات النهائية فقط." }
+        val plan = requireNotNull(db.planningDao().demandPlan(itemId, provinceCode, planYear, planMonth)) { "لا توجد خطة طلب لهذه المحافظة والشهر." }
+        require(plan.status == "APPROVED") { "اعتمد خطة الطلب قبل تسجيل طلبات الموزعين." }
+        val now = System.currentTimeMillis()
+        val orderNo = AutoNumberService(db).nextDocumentNo("DORD", now)
+        val id = db.planningDao().insertDistributorOrder(
+            DistributorOrderEntity(
+                orderNo = orderNo, customerId = customerId, itemId = itemId, provinceCode = provinceCode,
+                planYear = planYear, planMonth = planMonth, orderDate = now, quantityBase = quantityBase,
+                status = "DRAFT", notes = notes.trim(), createdBy = userId, createdAt = now,
+                updatedBy = userId, updatedAt = now
+            )
+        )
+        db.governanceDao().insertAudit(AuditEventEntity(userId=userId, action="CREATE", entityType="DISTRIBUTOR_ORDER", entityId=id.toString(), newValue="$orderNo|$provinceCode|$planYear-$planMonth|qty=$quantityBase|DRAFT", reason=notes.trim().ifBlank { "إنشاء طلب موزع" }))
+        id
+    }
+
+    suspend fun confirmDistributorOrder(id: Long, userId: Long) = db.withTransaction {
+        val dao = db.planningDao()
+        val row = requireNotNull(dao.distributorOrder(id)) { "طلب الموزع غير موجود." }
+        require(row.status == "DRAFT") { "يمكن تأكيد الطلبات المسودة فقط." }
+        val now = System.currentTimeMillis()
+        dao.updateDistributorOrder(row.copy(status="CONFIRMED", updatedBy=userId, updatedAt=now, confirmedBy=userId, confirmedAt=now, cancelReason=""))
+        db.governanceDao().insertAudit(AuditEventEntity(userId=userId, action="CONFIRM", entityType="DISTRIBUTOR_ORDER", entityId=id.toString(), oldValue="DRAFT", newValue="CONFIRMED|qty=${row.quantityBase}", reason="تأكيد طلب الموزع"))
+    }
+
+    suspend fun fulfillDistributorOrder(id: Long, userId: Long) = db.withTransaction {
+        val dao = db.planningDao()
+        val row = requireNotNull(dao.distributorOrder(id)) { "طلب الموزع غير موجود." }
+        require(row.status == "CONFIRMED") { "يجب تأكيد الطلب قبل تسجيل تنفيذه." }
+        val now = System.currentTimeMillis()
+        dao.updateDistributorOrder(row.copy(status="FULFILLED", updatedBy=userId, updatedAt=now, fulfilledBy=userId, fulfilledAt=now))
+        db.governanceDao().insertAudit(AuditEventEntity(userId=userId, action="FULFILL", entityType="DISTRIBUTOR_ORDER", entityId=id.toString(), oldValue="CONFIRMED", newValue="FULFILLED|qty=${row.quantityBase}", reason="تنفيذ طلب الموزع"))
+    }
+
+    suspend fun cancelDistributorOrder(id: Long, reason: String, userId: Long) = db.withTransaction {
+        val clean = reason.trim()
+        require(clean.isNotBlank()) { "سبب إلغاء طلب الموزع مطلوب." }
+        val dao = db.planningDao()
+        val row = requireNotNull(dao.distributorOrder(id)) { "طلب الموزع غير موجود." }
+        require(row.status == "DRAFT" || row.status == "CONFIRMED") { "لا يمكن إلغاء هذا الطلب في حالته الحالية." }
+        val now = System.currentTimeMillis()
+        dao.updateDistributorOrder(row.copy(status="CANCELLED", updatedBy=userId, updatedAt=now, cancelReason=clean))
+        db.governanceDao().insertAudit(AuditEventEntity(userId=userId, action="CANCEL", entityType="DISTRIBUTOR_ORDER", entityId=id.toString(), oldValue=row.status, newValue="CANCELLED|qty=${row.quantityBase}", reason=clean))
+    }
+
+    private fun provinceCodeForPlanning(province: String): String = when {
+        province.contains("تعز") -> "TAIZ"
+        province.contains("عدن") -> "ADEN"
+        province.contains("صنعاء") -> "SANAA"
+        else -> "OTHER"
+    }
+
 }
