+@Composable
+private fun DistributorOrderCreateDialog(
+    distributors: List<CustomerEntity>,
+    onDismiss: () -> Unit,
+    onSave: (CustomerEntity, Double, String) -> Unit
+) {
+    var selectedId by remember { mutableStateOf<Long?>(distributors.firstOrNull()?.id) }
+    var menuOpen by remember { mutableStateOf(false) }
+    var qtyText by remember { mutableStateOf("") }
+    var note by remember { mutableStateOf("") }
+    var error by remember { mutableStateOf<String?>(null) }
+    val selected = distributors.firstOrNull { it.id == selectedId }
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text("طلب موزع جديد") },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                if (distributors.isEmpty()) Text("لا يوجد موزع مؤهل في هذه المحافظة.", color = MaterialTheme.colorScheme.error)
+                else {
+                    ExposedDropdownMenuBox(expanded = menuOpen, onExpandedChange = { menuOpen = !menuOpen }) {
+                        OutlinedTextField(
+                            value = selected?.let { "${it.code} • ${it.nameAr}" } ?: "اختر الموزع",
+                            onValueChange = {}, readOnly = true, label = { Text("الموزع") }, trailingIcon = { ExposedDropdownMenuDefaults.TrailingIcon(expanded = menuOpen) },
+                            modifier = Modifier.menuAnchor(MenuAnchorType.PrimaryNotEditable).fillMaxWidth()
+                        )
+                        ExposedDropdownMenu(expanded = menuOpen, onDismissRequest = { menuOpen = false }) {
+                            distributors.forEach { c -> DropdownMenuItem(text = { Text("${c.code} • ${c.nameAr}") }, onClick = { selectedId = c.id; menuOpen = false }) }
+                        }
+                    }
+                    OutlinedTextField(qtyText, { qtyText = it }, label = { Text("الكمية المطلوبة بالوحدة الأساسية") }, singleLine = true, modifier = Modifier.fillMaxWidth())
+                    OutlinedTextField(note, { note = it }, label = { Text("ملاحظة") }, modifier = Modifier.fillMaxWidth())
+                }
+                error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+            }
+        },
+        confirmButton = {
+            Button(enabled = distributors.isNotEmpty(), onClick = {
+                val qty = qtyText.trim().replace(',', '.').toDoubleOrNull()
+                if (selected == null) error = "اختر الموزع."
+                else if (qty == null || !qty.isFinite() || qty <= 0.0) error = "أدخل كمية أكبر من صفر."
+                else onSave(selected!!, qty, note)
+            }) { Text("حفظ مسودة") }
+        },
+        dismissButton = { TextButton(onClick = onDismiss) { Text("إلغاء") } }
+    )
+}
+
+@Composable
+private fun CancelDistributorOrderDialog(onDismiss: () -> Unit, onConfirm: (String) -> Unit) {
+    var reason by remember { mutableStateOf("") }
+    var error by remember { mutableStateOf<String?>(null) }
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text("إلغاء طلب الموزع") },
+        text = { Column { OutlinedTextField(reason, { reason = it }, label = { Text("سبب الإلغاء") }, modifier = Modifier.fillMaxWidth()); error?.let { Text(it, color = MaterialTheme.colorScheme.error) } } },
+        confirmButton = { Button(onClick = { if (reason.trim().isBlank()) error = "سبب الإلغاء مطلوب." else onConfirm(reason.trim()) }) { Text("إلغاء الطلب") } },
+        dismissButton = { TextButton(onClick = onDismiss) { Text("تراجع") } }
+    )
+}
 
