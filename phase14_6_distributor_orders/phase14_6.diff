diff -ruN original146/app/src/main/java/com/fush/erp/domain/DistributorOrderMath.kt modified146/app/src/main/java/com/fush/erp/domain/DistributorOrderMath.kt
--- original146/app/src/main/java/com/fush/erp/domain/DistributorOrderMath.kt	1970-01-01 00:00:00.000000000 +0000
+++ modified146/app/src/main/java/com/fush/erp/domain/DistributorOrderMath.kt	2026-08-13 00:01:38.680244497 +0000
@@ -0,0 +1,23 @@
+package com.fush.erp.domain
+
+object DistributorOrderMath {
+    fun committedQty(rows: List<Pair<String, Double>>): Double = rows
+        .filter { (status, _) -> status == "CONFIRMED" || status == "FULFILLED" }
+        .sumOf { (_, qty) -> qty }
+        .coerceAtLeast(0.0)
+
+    fun draftQty(rows: List<Pair<String, Double>>): Double = rows
+        .filter { (status, _) -> status == "DRAFT" }
+        .sumOf { (_, qty) -> qty }
+        .coerceAtLeast(0.0)
+
+    fun coveragePct(committedQty: Double, plannedQty: Double): Double =
+        if (plannedQty <= 0.0) 0.0 else (committedQty / plannedQty) * 100.0
+
+    fun remainingQty(committedQty: Double, plannedQty: Double): Double =
+        (plannedQty - committedQty).coerceAtLeast(0.0)
+}
