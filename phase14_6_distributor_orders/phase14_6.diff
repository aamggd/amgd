+private fun distributorProvinceCode(province: String): String = when {
+    province.contains("تعز") -> "TAIZ"
+    province.contains("عدن") -> "ADEN"
+    province.contains("صنعاء") -> "SANAA"
+    else -> "OTHER"
+}
+
+private fun distributorOrderStatusLabel(status: String): String = when (status) {
+    "DRAFT" -> "مسودة"
+    "CONFIRMED" -> "مؤكد"
+    "FULFILLED" -> "منفذ"
+    "CANCELLED" -> "ملغي"
+    else -> status
+}
+
+private fun planningProvinceLabel(code: String): String = when (code) {
+    "TAIZ" -> "تعز"
+    "ADEN" -> "عدن"
+    "SANAA" -> "صنعاء"
+    else -> "أخرى"
+}
+
+private fun planningDate(epoch: Long): String = SimpleDateFormat("yyyy-MM-dd", Locale.US).format(Date(epoch))
