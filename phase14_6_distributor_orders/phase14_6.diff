+package com.fush.erp.domain
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class DistributorOrderMathTest {
+    @Test
+    fun committed_excludes_draft_and_cancelled() {
+        val rows = listOf(
+            "DRAFT" to 10.0,
+            "CONFIRMED" to 20.0,
+            "FULFILLED" to 30.0,
+            "CANCELLED" to 40.0
+        )
+        assertEquals(50.0, DistributorOrderMath.committedQty(rows), 0.000001)
+        assertEquals(10.0, DistributorOrderMath.draftQty(rows), 0.000001)
+    }
+
+    @Test
+    fun coverage_and_remaining_follow_approved_plan() {
+        assertEquals(75.0, DistributorOrderMath.coveragePct(75.0, 100.0), 0.000001)
+        assertEquals(25.0, DistributorOrderMath.remainingQty(75.0, 100.0), 0.000001)
+        assertEquals(0.0, DistributorOrderMath.remainingQty(120.0, 100.0), 0.000001)
+    }
+
+    @Test
+    fun zero_plan_has_zero_coverage() {
+        assertEquals(0.0, DistributorOrderMath.coveragePct(10.0, 0.0), 0.000001)
+    }
+}
