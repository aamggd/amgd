+package com.fush.erp.domain
+
+import java.util.Locale
+
+/**
+ * Canonical employee entitlement categories for HR/payroll integrations.
+ *
+ * P1 intentionally defines the type contract only. Lifecycle state and payment
+ * handling belong to later phases and are not introduced here.
+ */
+enum class EmployeeEntitlementEffect {
+    INCREASES_PAYABLE,
+    REDUCES_PAYABLE
+}
+
+enum class EmployeeEntitlementType(
+    val code: String,
+    val labelAr: String,
+    val effect: EmployeeEntitlementEffect,
+    val requiresOperationalSource: Boolean
+) {
+    PRODUCTION(
+        code = "PRODUCTION",
+        labelAr = "إنتاج",
+        effect = EmployeeEntitlementEffect.INCREASES_PAYABLE,
+        requiresOperationalSource = true
+    ),
+    SALARY(
+        code = "SALARY",
+        labelAr = "راتب",
+        effect = EmployeeEntitlementEffect.INCREASES_PAYABLE,
+        requiresOperationalSource = false
+    ),
+    COMMISSION(
+        code = "COMMISSION",
+        labelAr = "عمولة",
+        effect = EmployeeEntitlementEffect.INCREASES_PAYABLE,
+        requiresOperationalSource = true
+    ),
+    ALLOWANCE(
+        code = "ALLOWANCE",
+        labelAr = "بدل",
+        effect = EmployeeEntitlementEffect.INCREASES_PAYABLE,
+        requiresOperationalSource = false
+    ),
+    ADVANCE(
+        code = "ADVANCE",
+        labelAr = "سلفة",
+        effect = EmployeeEntitlementEffect.REDUCES_PAYABLE,
+        requiresOperationalSource = false
+    ),
+    DEDUCTION(
+        code = "DEDUCTION",
+        labelAr = "خصم",
+        effect = EmployeeEntitlementEffect.REDUCES_PAYABLE,
+        requiresOperationalSource = false
+    );
+
+    val increasesPayable: Boolean
+        get() = effect == EmployeeEntitlementEffect.INCREASES_PAYABLE
+
+    companion object {
+        val canonicalCodes: Set<String> = values().mapTo(linkedSetOf()) { it.code }
+
+        fun parse(code: String): EmployeeEntitlementType {
+            val normalized = code.trim().uppercase(Locale.US)
+            return values().firstOrNull { it.code == normalized }
+                ?: throw IllegalArgumentException("نوع استحقاق الموظف غير مدعوم: $code")
+        }
+
+        fun isSupported(code: String): Boolean =
+            runCatching { parse(code) }.isSuccess
+    }
+}
+diff --git a/app/src/test/java/com/fush/erp/domain/EmployeeEntitlementTypeTest.kt b/app/src/test/java/com/fush/erp/domain/EmployeeEntitlementTypeTest.kt
