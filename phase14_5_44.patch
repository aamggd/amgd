+enum class FushThemeMode(val storageValue: String, val labelAr: String) {
+    SYSTEM("system", "حسب النظام"),
+    LIGHT("light", "فاتح"),
+    DARK("dark", "داكن");
+
+    companion object {
+        fun fromStorage(value: String?): FushThemeMode = entries.firstOrNull { it.storageValue == value } ?: SYSTEM
+    }
+}
+
+object FushThemePreferences {
+    private const val PREFS_NAME = "fush_ui_preferences"
+    private const val KEY_THEME_MODE = "theme_mode"
+
+    fun read(context: Context): FushThemeMode = FushThemeMode.fromStorage(
+        context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE).getString(KEY_THEME_MODE, FushThemeMode.SYSTEM.storageValue)
+    )
+
+    fun write(context: Context, mode: FushThemeMode) {
+        context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+            .edit()
+            .putString(KEY_THEME_MODE, mode.storageValue)
+            .apply()
+    }
+}
+
