+                        Scaffold(
+                            bottomBar = {
+                                NavigationBar(Modifier.testTag("bottom-navigation")) {
+                                    repeat(5) { index ->
+                                        NavigationBarItem(
+                                            selected = index == 3,
+                                            onClick = {},
+                                            icon = { Text((index + 1).toString()) },
+                                            label = { Text(if (index == 3) "المخزون" else "قسم") },
+                                        )
+                                    }
+                                }
+                            },
+                        ) { innerPadding ->
+                            LazyColumn(
+                                modifier = Modifier.fillMaxSize().padding(innerPadding).testTag("inventory-scroll"),
+                                contentPadding = androidx.compose.foundation.layout.PaddingValues(bottom = 36.dp),
+                            ) {
+                                item { Spacer(Modifier.height(520.dp)) }
+                                item {
+                                    InventorySectionTabs(
+                                        selectedSection = "الأرصدة",
+                                        onSectionSelected = {},
+                                        modifier = Modifier.fillMaxWidth().testTag("inventory-tabs"),
+                                    )
+                                    Spacer(Modifier.height(18.dp))
+                                }
+                                item { Spacer(Modifier.height(200.dp)) }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        compose.onNodeWithTag("inventory-tabs").performScrollTo()
+        labels.forEach { label -> compose.onNodeWithText(label).assertIsDisplayed() }
+
+        val phone = compose.onNodeWithTag("narrow-phone").fetchSemanticsNode().boundsInRoot
+        val tabs = compose.onNodeWithTag("inventory-tabs").fetchSemanticsNode().boundsInRoot
+        val bottomNav = compose.onNodeWithTag("bottom-navigation").fetchSemanticsNode().boundsInRoot
+
+        assertTrue("tabs clipped on left", tabs.left >= phone.left - 1f)
+        assertTrue("tabs clipped on right", tabs.right <= phone.right + 1f)
+        assertTrue("tabs overlap bottom navigation", tabs.bottom <= bottomNav.top + 1f)
+        assertTrue("tabs must have positive visible height", tabs.height > 0f)
+
+        val bitmap = compose.onNodeWithTag("narrow-phone").captureToImage().asAndroidBitmap()
+        val context = InstrumentationRegistry.getInstrumentation().targetContext
+        val output = File(context.filesDir, "inventory-14.5.46-narrow-360dp.png")
+        FileOutputStream(output).use { stream -> bitmap.compress(Bitmap.CompressFormat.PNG, 100, stream) }
+        assertTrue("visual evidence screenshot was not created", output.isFile && output.length() > 0L)
+    }
+}
