+package com.fush.erp.cloud
+
+/**
+ * Pure decision helpers for the commercial company bootstrap path.
+ * Kept free of Android/network dependencies so Supabase auth edge cases are deterministic in JVM tests.
+ */
+internal object CommercialCompanyBootstrapPolicy {
+    private val accessTokenPattern = Regex("\\\"access_token\\\"\\s*:\\s*\\\"([^\\\"]+)\\\"")
+    private val confirmationPattern = Regex("\\\"confirmation_sent_at\\\"\\s*:\\s*\\\"([^\\\"]+)\\\"")
+    private val identitiesPattern = Regex("\\\"identities\\\"\\s*:\\s*\\[(.*?)]", setOf(RegexOption.DOT_MATCHES_ALL))
+
+    fun hasSession(signUpBody: String): Boolean =
+        accessTokenPattern.find(signUpBody)?.groupValues?.getOrNull(1)?.isNotBlank() == true
+
+    fun shouldAttemptSignInAfterSignUp(httpCode: Int?, signUpBody: String): Boolean {
+        if (httpCode != null && httpCode in 200..299) return !hasSession(signUpBody)
+        if (httpCode == 422 || httpCode == 400) {
+            val normalized = signUpBody.lowercase()
+            return "already" in normalized || "registered" in normalized || "exists" in normalized
+        }
+        return false
+    }
+
+    fun looksLikeNewUnconfirmedAccount(signUpBody: String): Boolean {
+        if (confirmationPattern.find(signUpBody)?.groupValues?.getOrNull(1)?.isNotBlank() == true) return true
+        val identitiesBody = identitiesPattern.find(signUpBody)?.groupValues?.getOrNull(1)?.trim().orEmpty()
+        return identitiesBody.isNotEmpty()
+    }
+
+    fun isDuplicateOrganizationCode(httpCode: Int?, body: String): Boolean {
+        val normalized = body.lowercase()
+        return httpCode == 409 ||
+            "23505" in normalized ||
+            "duplicate key" in normalized ||
+            ("unique" in normalized && ("organization" in normalized || "code" in normalized))
+    }
+}
