+package com.fush.erp.cloud
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class V219CompanyBootstrapAuthPolicyTest {
+    @Test
+    fun `new email with signup session continues without fallback sign in`() {
+        val body = """{"access_token":"token","refresh_token":"refresh","user":{"id":"u1"}}"""
+        assertTrue(CommercialCompanyBootstrapPolicy.hasSession(body))
+        assertFalse(CommercialCompanyBootstrapPolicy.shouldAttemptSignInAfterSignUp(200, body))
+    }
+
+    @Test
+    fun `existing confirmed email with privacy preserving 200 no session falls back to sign in`() {
+        val body = """{"user":{"id":"opaque","identities":[]},"session":null}"""
+        assertFalse(CommercialCompanyBootstrapPolicy.hasSession(body))
+        assertTrue(CommercialCompanyBootstrapPolicy.shouldAttemptSignInAfterSignUp(200, body))
+        assertFalse(CommercialCompanyBootstrapPolicy.looksLikeNewUnconfirmedAccount(body))
+    }
+
+    @Test
+    fun `new unconfirmed account is distinguished after sign in cannot proceed`() {
+        val body = """{"user":{"id":"new-user","confirmation_sent_at":"2026-09-10T00:00:00Z","identities":[{"id":"identity-1"}]},"session":null}"""
+        assertTrue(CommercialCompanyBootstrapPolicy.shouldAttemptSignInAfterSignUp(200, body))
+        assertTrue(CommercialCompanyBootstrapPolicy.looksLikeNewUnconfirmedAccount(body))
+    }
+
+    @Test
+    fun `legacy already registered auth error also falls back to sign in`() {
+        val body = """{"msg":"User already registered"}"""
+        assertTrue(CommercialCompanyBootstrapPolicy.shouldAttemptSignInAfterSignUp(422, body))
+    }
+
+    @Test
+    fun `wrong password is not mistaken for a signup success`() {
+        val loginError = """{"error_code":"invalid_credentials","msg":"Invalid login credentials"}"""
+        assertFalse(CommercialCompanyBootstrapPolicy.shouldAttemptSignInAfterSignUp(401, loginError))
+    }
+
+    @Test
+    fun `duplicate organization code is recognized from postgres unique violation`() {
+        val body = """{"code":"23505","message":"duplicate key value violates unique constraint fush_organizations_code_key"}"""
+        assertTrue(CommercialCompanyBootstrapPolicy.isDuplicateOrganizationCode(400, body))
+        assertTrue(CommercialCompanyBootstrapPolicy.isDuplicateOrganizationCode(409, "{}"))
+    }
+}
