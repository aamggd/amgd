+package com.fush.erp.cloud
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+class V219CompanyBootstrapSourceContractTest {
+    private fun source(path: String): String = File("app/" + path).readText()
+
+    @Test
+    fun `create company uses rpc returned tenant and never resolves old membership before creation`() {
+        val repo = source("src/main/java/com/fush/erp/cloud/CloudSyncRepository.kt")
+        val start = repo.indexOf("suspend fun createCommercialCompany(")
+        val end = repo.indexOf("private fun registerBootstrapDevice", start)
+        val method = repo.substring(start, end)
+        assertTrue(method.contains("/rest/v1/rpc/fush_create_organization"))
+        assertTrue(method.contains("rawSession.copy(organizationId = organizationId)"))
+        assertFalse(method.contains("when (val tenant = resolveOrganization(rawSession))"))
+        assertTrue(method.contains("membershipRole != \"OWNER\""))
+    }
+
+    @Test
+    fun `rpc failure and duplicate code always return explicit failure`() {
+        val repo = source("src/main/java/com/fush/erp/cloud/CloudSyncRepository.kt")
+        assertTrue(repo.contains("CommercialCompanyBootstrapPolicy.isDuplicateOrganizationCode"))
+        assertTrue(repo.contains("رمز الشركة $normalizedCode مستخدم مسبقًا"))
+        assertTrue(repo.contains("CloudOperationResult.Failure(message, created.code)"))
+    }
+
+    @Test
+    fun `device is bound to the new organization after owner verification`() {
+        val repo = source("src/main/java/com/fush/erp/cloud/CloudSyncRepository.kt")
+        assertTrue(repo.contains("bindDatabaseOrganization(organizationId)"))
+        assertTrue(repo.contains("registerBootstrapDevice(scopedSession)"))
+        assertTrue(repo.contains("on_conflict=organization_id,user_id,device_key"))
+    }
+
+    @Test
+    fun `screen cannot silently fail and navigates to license after success`() {
+        val screen = source("src/main/java/com/fush/erp/ui/screens/CommercialCloudLinkScreen.kt")
+        val shell = source("src/main/java/com/fush/erp/ui/screens/CommercialRestrictedShell.kt")
+        assertTrue(screen.contains("onProgress = { progress ->"))
+        assertTrue(screen.contains("catch (t: Throwable)"))
+        assertTrue(screen.contains("finally"))
+        assertTrue(screen.contains("busy = false"))
+        assertTrue(screen.contains("تم إنشاء الشركة وربط المالك بنجاح"))
+        assertTrue(screen.contains("onNavigateToLicense()"))
+        assertTrue(shell.contains("onNavigateToLicense = { tab = \"license\" }"))
+    }
+
+    @Test
+    fun `all requested progress stages are defined`() {
+        val models = source("src/main/java/com/fush/erp/cloud/CloudModels.kt")
+        listOf("CREATING_ACCOUNT", "SIGNING_IN", "CREATING_COMPANY", "LINKING_OWNER", "BINDING_DEVICE", "SUCCESS")
+            .forEach { assertTrue(models.contains(it)) }
+    }
+
+    @Test
+    fun `room schema is unchanged by v219 and destructive migration remains absent`() {
+        val db = source("src/main/java/com/fush/erp/data/FushDatabase.kt")
+        val allMain = File("app/src/main/java").walkTopDown().filter { it.isFile && it.extension == "kt" }.joinToString("\n") { it.readText() }
+        assertTrue(db.contains("const val FUSH_DB_SCHEMA_VERSION = 55"))
+        assertFalse(allMain.contains("fallbackToDestructiveMigration"))
+    }
+
+    @Test
+    fun `multi tenant rls acceptance test dynamically blocks cross tenant reads`() {
+        val sql = File("V213_MULTI_TENANT_RLS_TEST.sql").readText()
+        assertTrue(sql.contains("RLS FAIL: user A can see tenant B"))
+        assertTrue(sql.contains("RLS FAIL: user B can see tenant A"))
+        assertTrue(sql.contains("Dynamic cross-read gate over every tenant-scoped FUSH table"))
+        assertTrue(sql.contains("rollback;"))
+    }
+}
