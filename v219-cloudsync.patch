+    private fun registerBootstrapDevice(session: CloudSession): CloudOperationResult<Unit> {
+        val now = Instant.now().toString()
+        val deviceName = buildDeviceName()
+        val payload = JSONObject()
+            .put("organization_id", session.requireOrganizationId())
+            .put("user_id", session.userId)
+            .put("device_key", deviceKey())
+            .put("device_name", deviceName)
+            .put("app_version", BuildConfig.VERSION_NAME)
+            .put("last_seen_at", now)
+            .put("updated_at", now)
+            .toString()
+        val path = "/rest/v1/fush_sync_devices?on_conflict=organization_id,user_id,device_key"
+        return when (val response = request(
+            method = "POST",
+            path = path,
+            body = payload,
+            bearerToken = session.accessToken,
+            prefer = "resolution=merge-duplicates,return=minimal",
+        )) {
+            is HttpResult.Error -> CloudOperationResult.Failure(apiErrorMessage(response), response.code)
+            is HttpResult.Ok -> CloudOperationResult.Success(Unit)
+        }
+    }
