+    private suspend fun requirePurchaseCashRefundTimelineCovered(
+        invoice: PurchaseInvoiceEntity,
+        proposedRefundBase: Double = 0.0,
+        proposedCashDeltaBase: Double = 0.0,
+        eventDate: Long
+    ) {
+        val relevantDates = buildSet {
+            add(eventDate)
+            db.purchaseDao().supplierPaymentsForInvoice(invoice.id)
+                .filter { it.paymentDate >= eventDate }
+                .forEach { add(it.paymentDate) }
+            db.purchaseDao().returnsForInvoice(invoice.id)
+                .filter { it.status == "POSTED" && it.settlementType == "CASH_REFUND" && it.returnDate >= eventDate }
+                .forEach { add(it.returnDate) }
+        }.sorted()
+
+        for (date in relevantDates) {
+            val actualPaidBase = if (invoice.paymentType == "CASH") {
+                invoice.totalBase
+            } else {
+                db.purchaseDao().paidBaseForInvoiceAsOf(invoice.id, date)
+            } + proposedCashDeltaBase
+            val refundedBase = db.purchaseDao().cashRefundedBaseForInvoiceAsOf(invoice.id, date)
+            CashRefundCoveragePolicy.requireCovered(
+                actualCashBase = actualPaidBase,
+                alreadyRefundedBase = refundedBase,
+                requestedRefundBase = proposedRefundBase,
+                context = "فاتورة الشراء ${invoice.invoiceNo}: استرداد المورد النقدي يجب أن يكون مغطى بالنقد المدفوع فعلياً"
+            )
+        }
+    }
+
