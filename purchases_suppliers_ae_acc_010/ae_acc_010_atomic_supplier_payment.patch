diff --git a/app/src/test/java/com/fush/erp/domain/AeAcc010SupplierPaymentAtomicityTest.kt b/app/src/test/java/com/fush/erp/domain/AeAcc010SupplierPaymentAtomicityTest.kt
new file mode 100644
--- /dev/null
+++ b/app/src/test/java/com/fush/erp/domain/AeAcc010SupplierPaymentAtomicityTest.kt
@@ -0,0 +1,82 @@
+package com.fush.erp.domain
+
+import java.io.File
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class AeAcc010SupplierPaymentAtomicityTest {
+    private val source: String by lazy {
+        val candidates = listOf(
+            File("src/main/java/com/fush/erp/domain/PurchaseService.kt"),
+            File("app/src/main/java/com/fush/erp/domain/PurchaseService.kt")
+        )
+        requireNotNull(candidates.firstOrNull { it.isFile }) {
+            "PurchaseService.kt was not found from ${File(".").absolutePath}"
+        }.readText()
+    }
+
+    @Test
+    fun aeAcc010EverySupplierPaymentEntryPointOwnsATransactionBoundary() {
+        val single = section(source, "suspend fun postSupplierPayment(", "suspend fun postSupplierPaymentAutoAllocate(")
+        val auto = section(source, "suspend fun postSupplierPaymentAutoAllocate(", "suspend fun postSupplierPaymentAllocations(")
+        val multi = section(source, "suspend fun postSupplierPaymentAllocations(", "private suspend fun postSupplierPaymentAllocationsInternal(")
+
+        assertTrue(single.contains("): SupplierPaymentResult = db.withTransaction {"))
+        assertTrue(auto.contains("): MultiSupplierPaymentResult = db.withTransaction {"))
+        assertTrue(multi.contains("): MultiSupplierPaymentResult = db.withTransaction {"))
+    }
+
+    @Test
+    fun aeAcc010JournalPreflightOccursBeforeAnyPaymentMutation() {
+        val internal = section(
+            source,
+            "private suspend fun postSupplierPaymentAllocationsInternal(",
+            "suspend fun reverseSupplierPayment("
+        )
+        val preflight = internal.indexOf("prepareSupplierPaymentJournalMulti(")
+        val numbering = internal.indexOf("numbering.nextDocumentNo(\"SPAY\"")
+        val paymentInsert = internal.indexOf("insertSupplierPayment(")
+        val allocationInsert = internal.indexOf("insertSupplierPaymentAllocation(")
+
+        assertTrue(preflight >= 0)
+        assertTrue(preflight < numbering)
+        assertTrue(preflight < paymentInsert)
+        assertTrue(preflight < allocationInsert)
+    }
+
+    @Test
+    fun aeAcc010PaymentMutationAndJournalWriteStayInOneRoomTransaction() {
+        val internal = section(
+            source,
+            "private suspend fun postSupplierPaymentAllocationsInternal(",
+            "suspend fun reverseSupplierPayment("
+        )
+        val paymentInsert = internal.indexOf("insertSupplierPayment(")
+        val allocationInsert = internal.indexOf("insertSupplierPaymentAllocation(")
+        val journalInsert = internal.indexOf("insertSupplierPaymentJournalMulti(")
+
+        assertTrue(internal.contains("check(db.inTransaction())"))
+        assertTrue(paymentInsert >= 0 && allocationInsert > paymentInsert)
+        assertTrue(journalInsert > allocationInsert)
+        assertFalse(internal.contains("launch("))
+        assertFalse(internal.contains("async("))
+    }
+
+    @Test
+    fun aeAcc010JournalPreflightIsWriteFreeAndValidatesBeforeMutation() {
+        val preflight = section(
+            source,
+            "private suspend fun prepareSupplierPaymentJournalMulti(",
+            "private suspend fun insertSupplierPaymentJournalMulti("
+        )
+        assertTrue(preflight.contains("AccountingValidator.validate(lines)"))
+        assertFalse(preflight.contains("insertSupplierPayment("))
+        assertFalse(preflight.contains("insertSupplierPaymentAllocation("))
+        assertFalse(preflight.contains("insertEntry("))
+        assertFalse(preflight.contains("insertLines("))
+    }
+
+    private fun section(text: String, start: String, end: String): String {
+        val startIndex = text.indexOf(start)
+        require(startIndex >= 0) { "Missing start marker: $start" }
+        val endIndex = text.indexOf(end, startIndex + start.length)
+        require(endIndex > startIndex) { "Missing end marker: $end" }
+        return text.substring(startIndex, endIndex)
+    }
+}
