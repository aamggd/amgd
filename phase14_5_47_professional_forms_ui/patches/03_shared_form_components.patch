+private const val FUSH_DATE_PATTERN = "yyyy-MM-dd"
+
+private fun parseDatePickerMillis(text: String): Long? = runCatching {
+    SimpleDateFormat(FUSH_DATE_PATTERN, Locale.US).apply {
+        isLenient = false
+        timeZone = TimeZone.getTimeZone("UTC")
+    }.parse(text.trim())?.time
+}.getOrNull()
+
+private fun formatDatePickerMillis(value: Long): String =
+    SimpleDateFormat(FUSH_DATE_PATTERN, Locale.US).apply {
+        timeZone = TimeZone.getTimeZone("UTC")
+    }.format(Date(value))
+
+/**
+ * UI-only date input. The stored value remains the existing yyyy-MM-dd string so
+ * domain parsing/posting behavior is unchanged; the picker only helps the user fill it.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun FushDateField(
+    value: String,
+    onValueChange: (String) -> Unit,
+    label: String,
+    modifier: Modifier = Modifier,
+    enabled: Boolean = true,
+    optional: Boolean = false,
+) {
+    var showPicker by remember { mutableStateOf(false) }
+
+    OutlinedTextField(
+        value = value,
+        onValueChange = onValueChange,
+        label = { Text(label) },
+        placeholder = { Text(FUSH_DATE_PATTERN) },
+        singleLine = true,
+        enabled = enabled,
+        keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Date),
+        trailingIcon = {
+            TextButton(
+                onClick = { showPicker = true },
+                enabled = enabled,
+                modifier = Modifier.heightIn(min = 48.dp),
+            ) { Text("اختيار") }
+        },
+        modifier = modifier,
+    )
+
+    if (showPicker) {
+        val initialMillis = remember(value) { parseDatePickerMillis(value) }
+        val pickerState = rememberDatePickerState(initialSelectedDateMillis = initialMillis)
+        DatePickerDialog(
+            onDismissRequest = { showPicker = false },
+            confirmButton = {
+                TextButton(
+                    onClick = {
+                        pickerState.selectedDateMillis?.let { onValueChange(formatDatePickerMillis(it)) }
+                        showPicker = false
+                    },
+                    enabled = pickerState.selectedDateMillis != null,
+                    modifier = Modifier.heightIn(min = 48.dp),
+                ) { Text("اعتماد") }
+            },
+            dismissButton = {
+                Row {
+                    if (optional && value.isNotBlank()) {
+                        TextButton(
+                            onClick = {
+                                onValueChange("")
+                                showPicker = false
+                            },
+                            modifier = Modifier.heightIn(min = 48.dp),
+                        ) { Text("مسح") }
+                    }
+                    TextButton(
+                        onClick = { showPicker = false },
+                        modifier = Modifier.heightIn(min = 48.dp),
+                    ) { Text("إلغاء") }
+                }
+            },
+        ) {
+            DatePicker(state = pickerState)
+        }
+    }
+}
