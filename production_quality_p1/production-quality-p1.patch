diff --git a/app/src/test/java/com/fush/erp/domain/ProductionIssueLotAllocatorTest.kt b/app/src/test/java/com/fush/erp/domain/ProductionIssueLotAllocatorTest.kt
new file mode 100644
--- /dev/null
+++ b/app/src/test/java/com/fush/erp/domain/ProductionIssueLotAllocatorTest.kt
@@ -0,0 +1,92 @@
+package com.fush.erp.domain
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertThrows
+import org.junit.Test
+
+class ProductionIssueLotAllocatorTest {
+    @Test
+    fun `splits issue across actual lots and preserves lot identity and cost`() {
+        val allocations = ProductionIssueLotAllocator.allocate(
+            requiredQtyBase = 8.0,
+            lotTracked = true,
+            expiryTracked = true,
+            itemLabel = "مادة خام (RM-1)",
+            candidates = listOf(
+                ProductionIssueLotCandidate("LOT-A", 2_000L, 5.0, 50.0),
+                ProductionIssueLotCandidate("LOT-B", 3_000L, 10.0, 120.0)
+            )
+        )
+
+        assertEquals(2, allocations.size)
+        assertEquals("LOT-A", allocations[0].lotNo)
+        assertEquals(5.0, allocations[0].quantityBase, 1e-9)
+        assertEquals(10.0, allocations[0].unitCostBase, 1e-9)
+        assertEquals("LOT-B", allocations[1].lotNo)
+        assertEquals(3.0, allocations[1].quantityBase, 1e-9)
+        assertEquals(12.0, allocations[1].unitCostBase, 1e-9)
+        assertEquals(8.0, allocations.sumOf { it.quantityBase }, 1e-9)
+    }
+
+    @Test
+    fun `rejects issue before movements when usable physical stock is insufficient`() {
+        val error = assertThrows(IllegalArgumentException::class.java) {
+            ProductionIssueLotAllocator.allocate(
+                requiredQtyBase = 8.0,
+                lotTracked = true,
+                expiryTracked = false,
+                itemLabel = "مادة خام (RM-1)",
+                candidates = listOf(
+                    ProductionIssueLotCandidate("LOT-A", null, 5.0, 50.0)
+                )
+            )
+        }
+
+        assertEquals(
+            "المخزون الفعلي المقبول وغير المنتهي لا يكفي لإتمام صرف مادة خام (RM-1)",
+            error.message
+        )
+    }
+
+    @Test
+    fun `lot tracked material cannot allocate from a row without lot number`() {
+        assertThrows(IllegalArgumentException::class.java) {
+            ProductionIssueLotAllocator.allocate(
+                requiredQtyBase = 1.0,
+                lotTracked = true,
+                expiryTracked = false,
+                itemLabel = "مادة خام (RM-1)",
+                candidates = listOf(
+                    ProductionIssueLotCandidate(null, null, 2.0, 20.0)
+                )
+            )
+        }
+    }
+
+    @Test
+    fun `expiry tracked material cannot allocate from a row without expiry`() {
+        assertThrows(IllegalArgumentException::class.java) {
+            ProductionIssueLotAllocator.allocate(
+                requiredQtyBase = 1.0,
+                lotTracked = false,
+                expiryTracked = true,
+                itemLabel = "مادة خام (RM-1)",
+                candidates = listOf(
+                    ProductionIssueLotCandidate(null, null, 2.0, 20.0)
+                )
+            )
+        }
+    }
+
+    @Test
+    fun `does not overdraw the last lot`() {
+        val allocations = ProductionIssueLotAllocator.allocate(
+            requiredQtyBase = 6.0,
+            lotTracked = false,
+            expiryTracked = false,
+            candidates = listOf(
+                ProductionIssueLotCandidate(null, null, 4.0, 40.0),
+                ProductionIssueLotCandidate(null, null, 9.0, 90.0)
+            )
+        )
+
+        assertEquals(listOf(4.0, 2.0), allocations.map { it.quantityBase })
+    }
+}
