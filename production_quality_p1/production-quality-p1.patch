+package com.fush.erp.domain
+
+import kotlin.math.abs
+import kotlin.math.min
+
+data class ProductionIssueLotCandidate(
+    val lotNo: String?,
+    val expiryDate: Long?,
+    val quantityBase: Double,
+    val inventoryValueBase: Double
+)
+
+data class ProductionIssueLotAllocation(
+    val lotNo: String?,
+    val expiryDate: Long?,
+    val quantityBase: Double,
+    val unitCostBase: Double
+)
+
+object ProductionIssueLotAllocator {
+    private const val EPS = 1e-9
+    private const val COMPLETION_EPS = 1e-7
+
+    fun allocate(
+        requiredQtyBase: Double,
+        lotTracked: Boolean,
+        expiryTracked: Boolean,
+        candidates: List<ProductionIssueLotCandidate>,
+        itemLabel: String? = null
+    ): List<ProductionIssueLotAllocation> {
+        require(requiredQtyBase > EPS && requiredQtyBase.isFinite()) {
+            "كمية الصرف المطلوبة غير صالحة"
+        }
+
+        var remaining = requiredQtyBase
+        val allocations = mutableListOf<ProductionIssueLotAllocation>()
+
+        for (candidate in candidates) {
+            if (remaining <= EPS) break
+            if (candidate.quantityBase <= EPS) continue
+            require(candidate.quantityBase.isFinite()) { "رصيد التشغيلة غير صالح" }
+            require(candidate.inventoryValueBase.isFinite()) { "قيمة مخزون التشغيلة غير صالحة" }
+
+            ProductionMath.validateIssueLotTracking(
+                lotTracked = lotTracked,
+                expiryTracked = expiryTracked,
+                lotNo = candidate.lotNo,
+                expiryDate = candidate.expiryDate,
+                itemLabel = itemLabel
+            )
+
+            val allocatedQty = min(remaining, candidate.quantityBase)
+            val unitCost = candidate.inventoryValueBase / candidate.quantityBase
+            require(unitCost.isFinite()) { "تكلفة التشغيلة غير صالحة" }
+
+            allocations += ProductionIssueLotAllocation(
+                lotNo = candidate.lotNo,
+                expiryDate = candidate.expiryDate,
+                quantityBase = allocatedQty,
+                unitCostBase = unitCost
+            )
+            remaining -= allocatedQty
+        }
+
+        require(remaining <= COMPLETION_EPS) {
+            val label = itemLabel?.takeIf { it.isNotBlank() } ?: "الصنف"
+            "المخزون الفعلي المقبول وغير المنتهي لا يكفي لإتمام صرف $label"
+        }
+
+        val allocatedTotal = allocations.sumOf { it.quantityBase }
+        check(abs(allocatedTotal - requiredQtyBase) <= COMPLETION_EPS) {
+            "تعذر مطابقة كمية الصرف مع تخصيص التشغيلات"
+        }
+        return allocations
+    }
+}
