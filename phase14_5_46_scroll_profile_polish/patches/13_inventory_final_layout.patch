+@Composable
+internal fun InventorySectionTabs(
+    selectedSection: String,
+    onSectionSelected: (String) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val inventorySections = remember { listOf("الأرصدة", "تنبيهات", "الجرد", "التحويلات", "التشغيلات", "الحركة") }
+    CompositionLocalProvider(LocalLayoutDirection provides LayoutDirection.Rtl) {
+        Column(
+            modifier = modifier.fillMaxWidth().wrapContentHeight(),
+            verticalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+            inventorySections.chunked(2).forEach { rowSections ->
+                Row(
+                    modifier = Modifier.fillMaxWidth().wrapContentHeight(),
+                    horizontalArrangement = Arrangement.spacedBy(10.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                ) {
+                    rowSections.forEach { label ->
+                        FilterChip(
+                            selected = selectedSection == label,
+                            onClick = { onSectionSelected(label) },
+                            label = {
+                                Text(
+                                    text = label,
+                                    modifier = Modifier.fillMaxWidth(),
+                                    textAlign = androidx.compose.ui.text.style.TextAlign.Center,
+                                    softWrap = true,
+                                )
+                            },
+                            modifier = Modifier
+                                .weight(1f)
+                                .heightIn(min = 48.dp)
+                                .wrapContentHeight(),
+                        )
+                    }
+                    if (rowSections.size == 1) {
+                        Spacer(Modifier.weight(1f))
+                    }
+                }
+            }
+        }
+    }
+}
